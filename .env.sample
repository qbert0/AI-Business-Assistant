# Compose defaults
COMPOSE_PROJECT_NAME=ai-business-assistant
DOCKER_VOLUME_DIRECTORY=../docker_volumes

# Database-service: MariaDB
MARIADB_VERSION=11.2
MARIADB_CONTAINER_NAME=mariadb_app
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=precisioncast
MARIADB_USER=precisioncast
MARIADB_PASSWORD=precisioncast123

# Database-service: MinIO
MINIO_VERSION=latest
MINIO_CONTAINER_NAME=precisioncast-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=business-documents
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=http://62.107.25.198:32187


# Server_service
SERVER_SERVICE_CONTAINER_NAME=server_app
SERVER_SERVICE_PORT=8004
DATABASE_URL=mysql+pymysql://precisioncast:precisioncast123@mariadb:3306/precisioncast
JWT_SECRET_KEY=change-this-local-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SEARCH_SERVICE_URL=http://search-service:8000
SEARCH_SERVICE_TIMEOUT=10
RAG_SERVICE_URL=http://rag-service:8000
RAG_SEARCH_TIMEOUT=10
MODEL_SERVICE_URL=http://model_service:8888
MODEL_SERVICE_TIMEOUT=90
GOOGLE_OAUTH_CLIENT_ID=620943412298-qgf75rsv1qm0rcsqnncm9lj9ubssge11.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# Client_service
CLIENT_SERVICE_CONTAINER_NAME=client_app
CLIENT_SERVICE_PORT=8501
NUXT_BACKEND_API_BASE_URL=http://server_service:8000
NUXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_GOOGLE_CLIENT_ID=620943412298-qgf75rsv1qm0rcsqnncm9lj9ubssge11.apps.googleusercontent.com
CLIENT_JWT_SECRET=local-dev-secret-change-me

# Plugin-service
PLUGIN_SERVICE_CONTAINER_NAME=plugin_service_app
PLUGIN_SERVICE_PORT=8002

# Model_service: MariaDB
MODEL_MARIADB_VERSION=11.2
MODEL_MARIADB_CONTAINER_NAME=model_mariadb_app
MODEL_MARIADB_PORT=3307
MODEL_MARIADB_ROOT_PASSWORD=rootpassword
MODEL_MARIADB_DATABASE=model_service
MODEL_MARIADB_USER=model_service
MODEL_MARIADB_PASSWORD=model_service123

# Model_service application
MODEL_SERVICE_CONTAINER_NAME=model_service_app
MODEL_SERVICE_PORT=8888
MODEL_SERVICE_DATABASE_URL=mysql+pymysql://model_service:model_service123@model_mariadb:3306/model_service
MODEL_SERVICE_SECRET_KEY=change-this-model-service-secret
MODEL_SERVICE_CORS_ORIGINS=*
DEFAULT_INFERENCE_TIMEOUT_SECONDS=180
DEFAULT_PROVIDER_TIMEOUT_SECONDS=180

# Search-service: Elasticsearch
STACK_VERSION=9.3.3
ELASTICSEARCH_CONTAINER_NAME=elasticsearch_app
ELASTICSEARCH_CLUSTER_NAME=ai-business-assistant-search
ELASTICSEARCH_NODE_NAME=es01
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_MEMORY_LOCK=true
ELASTICSEARCH_SECURITY_ENABLED=false
ELASTICSEARCH_ENROLLMENT_ENABLED=false
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_REQUEST_TIMEOUT=30

# Search-service application
SEARCH_ENGINE_BACKEND=elasticsearch
SEARCH_SERVICE_CONTAINER_NAME=search_service_app
SEARCH_SERVICE_PORT=8001
ELASTICSEARCH_URL=http://localhost:9200
SEARCH_SERVICE_ELASTICSEARCH_URL=http://elasticsearch:9200

# Rag-service application
RAG_SERVICE_CONTAINER_NAME=rag_service_app
RAG_SERVICE_PORT=8003

# Rag-service: Neo4j
RAG_NEO4J_IMAGE=neo4j:5.26.0
RAG_NEO4J_CONTAINER_NAME=rag_neo4j
RAG_NEO4J_AUTH=neo4j/pleaseletmein
RAG_NEO4J_HTTP_PORT=7474
RAG_NEO4J_BOLT_PORT=7687
RAG_NEO4J_PLUGINS=["apoc"]
RAG_NEO4J_HEAP_INITIAL=512m
RAG_NEO4J_HEAP_MAX=512m

# Worker_service container
WORKER_SERVICE_CONTAINER_NAME=worker_service_app

# Worker_service Redis container
WORKER_REDIS_IMAGE=redis:7-alpine
WORKER_REDIS_CONTAINER_NAME=worker_redis
WORKER_REDIS_PORT=6379
WORKER_REDIS_APPENDONLY=yes
